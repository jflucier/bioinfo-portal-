sub getBlastPath{
    my($self) = @_;
    my $cacheName = "_blast_path";
    if (!defined($self->{$cacheName})) {
        $self->{$cacheName} = tempdir(File::Spec->tmpdir()."/offtarget.XXXX", CLEANUP => 1);
    }
    return $self->{$cacheName};
}


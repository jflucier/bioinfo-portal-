package designs::Experiment::CRISPR::CRISPRDesign;
use strict;

use designs::Experiment::CRISPR::TemplateSequence;

use Util::FileSystemUtil;
use Error ':try';

use constant CRISPR_SIZE => 20;
use constant CRISPR_TAIL => "UAUGAUAGGGACUUAGGGUG";
use constant CRISPR_MAX_PRED_OVERLAP => 5;

sub findCRISPR {
    my($geneName,$seq)=@_;
#     print STDERR "$geneName as size " . length($seq) . "\n";
    my $template = designs::Experiment::CRISPR::TemplateSequence->new('sequence' => $seq);
    my @validCRISPR;
    #Generate all the putative toss
    my $seqId = 1;
    foreach my $i (0..(length($seq) - CRISPR_SIZE)){
        my $targetSeq=substr($seq,$i,CRISPR_SIZE);
#         print STDERR "doing seq $targetSeq\n";
        my $tossSeq = getCRISPRFromSeq($targetSeq);
        my $criterias = validateCRISPRCriteria($tossSeq);
        if(isAllValidCRISPRCriteria($criterias)){
#             print STDERR "is valid $targetSeq\n";
            push(
                @validCRISPR,
                {
                    id => $seqId,
                    sequence => $targetSeq,
                    rna_sequence => $tossSeq,
                    rna_seq_no_tail => getCRISPRFromSeqNoTail($targetSeq),
                    criteria => $criterias
                }
            );
            $seqId++;
        }
    }
    # execute filters on siRNAs with a valid score
    if(scalar(@validCRISPR) > 0){
        # we have sirna prediction
        
        executeCRISPRFilters($geneName,\@validCRISPR,$template);
    }
    my @sorted = sort sortResults @validCRISPR;
    return \@sorted;
}

sub isOverlappingPredictions {
    my($template,$pred1,$pred2) = @_;
    my $pred1Pos5 = getPrediction5PrimePosition($template,$pred1);
    my $pred2Pos5 = getPrediction5PrimePosition($template,$pred2);
    
    if( abs($pred1Pos5 - $pred2Pos5) < CRISPR_MAX_PRED_OVERLAP){
        return 1;
    }
    
    return 0;
}

sub getPrediction5PrimePosition {
    my($template,$pred1) = @_;
    my ($self, $toss) = @_;
    my $pos = index($template,$pred1->{'sequence'});
    return $pos;
}

sub getCRISPRFromSeq {
    my($tossSeq) = @_;
    my $rnaSeq = rc($tossSeq);
    $rnaSeq =~ s/T/U/gi;
    return CRISPR_TAIL . $rnaSeq;
}

sub getCRISPRFromSeqNoTail {
    my($tossSeq) = @_;
    my $rnaSeq = rc($tossSeq);
    $rnaSeq =~ s/T/U/gi;
    return $rnaSeq;
}

sub rc {
    my ($seq) = @_;
    $seq = reverse($seq);
    $seq =~ tr/ACGTUacgtu/TGCAAtgcaa/;
    $seq;
}

sub sortResults{
    my $a_offtarget_major = scalar(@{$a->{filters}->{OffTargets}->{major}});
    my $b_offtarget_major = scalar(@{$b->{filters}->{OffTargets}->{major}});
    return 
        (
            ($b->{filters}->{'5ss_distance_score'} <=> $a->{filters}->{'5ss_distance_score'})
            or ($a_offtarget_major <=> $b_offtarget_major)
            or ($b->{filters}->{'ese_ess_mapping'}->{'score'} <=> $a->{filters}->{'ese_ess_mapping'}->{'score'})
            or ($a->{filters}->{'5ss_distance'} <=> $b->{filters}->{'5ss_distance'})
        );
}

sub isAllValidCRISPRCriteria {
    my($criterias) = @_;
    foreach my $crit (@$criterias){
        if(!$crit->validateCriteria()){
            # criteria is not respected, so not all core criterias are ok
            return 0;
        }
    }
    
    return 1;
}

sub validateCRISPRCriteria{
    my($tossSeq)=@_;
#     my $directory = '/home/jflucier/localhost/inHousePerLib/designs/CRISPRCriteria';
    my $directory = Util::FileSystemUtil::getFullExecPath('PERL5LIB','designs/Experiment/CRISPR/CRISPRCriteria');
    opendir (DIR, $directory) or die $!;
    my @criterias;
    while (my $file = readdir(DIR)) {
        if($file =~ m/^(\w|\d)+\.pm$/){
            ($file) = $file =~ /((\w|\d)+)\.\w+/;
            eval "require designs::Experiment::CRISPR::CRISPRCriteria::$1";
            if ($@) {
                my $msg = "unable to find toss criteria package : require designs::Experiment::CRISPR::CRISPRCriteria::$file. Exception: $@\n";
                print STDERR $msg;
                throw Error::Simple($msg);
            }
            
            #Call the method with the parameters
            my $crit = eval "designs::Experiment::CRISPR::CRISPRCriteria::$file->new();";
            $crit->validateCriteria($tossSeq);
            push(@criterias,$crit);
        }

    }
    closedir(DIR);
    # sort by criteria nbr
    my @sorted = sort { $a->getCriteriaNbr() <=> $b->getCriteriaNbr() } @criterias;
    return \@sorted;
}


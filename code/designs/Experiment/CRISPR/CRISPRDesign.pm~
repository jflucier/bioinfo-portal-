sub executeCRISPRFilters {
    my($geneName,$tossList,$template) = @_;
#     my $directory = '/home/jflucier/localhost/inHousePerLib/designs/CRISPRFilters';
    my $directory = Util::FileSystemUtil::getFullExecPath('PERL5LIB','designs/Experiment/CRISPR/CRISPRFilters');
    opendir (DIR, $directory) or die $!;
    while (my $file = readdir(DIR)) {
        if($file =~ m/^(\w|\d)+\.pm$/){
            ($file) = $file =~ /((\w|\d)+)\.\w+/;
            eval "require designs::Experiment::CRISPR::CRISPRFilters::$file";
            if ($@) {
                my $msg = "unable to find sirna filter package : require designs::Experiment::CRISPR::CRISPRFilters::$file. Exception: $@\n";
                print STDERR $msg;
                throw Error::Simple($msg);
            }
            
            #Call the method with the parameters
            my $filter = eval "designs::Experiment::CRISPR::CRISPRFilters::$file->new();";
#             print STDERR "designs::CRISPRFilters::$file->new();\n";
            # newList entries is = to $tossList with a new attribute for each entry 
            # named after filter. This new attribute has the filter result name has key for, id and name associated to it.
            $filter->executeFilter($geneName,$tossList,$template);
        }
    }
    closedir(DIR);
}

